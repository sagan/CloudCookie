    "@types/react-dom": "^19.3.0",
    "@types/webextension-polyfill": "^0.12.6",
    "autoprefixer": "^10.7.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
